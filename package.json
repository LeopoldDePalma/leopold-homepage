{
  "name": "leopold-homepage",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && npm run theme:typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepare": "husky",
    "model:helmet": "node scripts/build-helmet-model.mts",
    "spotify:auth": "node --env-file=.env.local scripts/spotify-auth.mts",
    "theme:typegen": "chakra typegen src/styles/system.ts",
    "postinstall": "node scripts/copy-basis-transcoder.mts && npm run theme:typegen"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tabler/icons-react": "^3.48.0",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "^5.7.0",
    "three": "^0.182.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.37.0",
    "@gltf-transform/cli": "^4.5.0",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.6.0",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{ts,tsx,mts}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,mjs,json,css,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
