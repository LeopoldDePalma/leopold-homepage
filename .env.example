# Spotify "now playing" on the home page. Without these the section stays off.
# Create an app at https://developer.spotify.com/dashboard with the redirect URI
# http://127.0.0.1:8888/callback, then run `npm run spotify:auth` for the refresh token.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

GITHUB_TOKEN=
